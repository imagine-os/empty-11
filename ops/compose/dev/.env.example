# PAP-42 local dev stack env vars. This file is NOT the root `.env.example`
# (that is PAP-13's root file, out of this issue's paths — see
# docs/platform/dev-stack.md "Deviations"). Once PAP-17's typed env config
# lands, fold the vars below into the root `.env.example`/`.env.local`; until
# then, copy what you need by hand after `bin/up.sh`.
#
# Names match the PAP-42 Interface Contract (which cites PAP-17's naming).

# App role: subject to row-level security (PAP-34).
DATABASE_URL=postgresql://paperos_app:paperos_dev_local@localhost:5432/paperos_dev

# Owner role: runs migrations (PAP-32), bypasses RLS.
DATABASE_URL_MIGRATOR=postgresql://paperos_owner:paperos_dev_local@localhost:5432/paperos_dev

# Read-only role.
DATABASE_URL_READONLY=postgresql://paperos_readonly:paperos_dev_local@localhost:5432/paperos_dev

# Electric's own connection (direct, not pooled — see ADR 0004).
DATABASE_URL_ELECTRIC=postgresql://electric:paperos_dev_local@localhost:5432/paperos_dev

S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=paperos_dev
S3_SECRET_KEY=paperos_dev_local
S3_BUCKET=paperos-dev

SMTP_URL=smtp://localhost:1025

ELECTRIC_URL=http://localhost:3000

# Not wired yet — no Hocuspocus container ships in this pass (see
# docs/platform/dev-stack.md "Deviations"). Placeholder so the name is
# reserved for whichever issue adds the real service.
YJS_URL=ws://localhost:1234
