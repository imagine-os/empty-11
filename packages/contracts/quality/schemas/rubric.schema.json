{
  "$id": "https://paperos.dev/schemas/quality/rubric.schema.json",
  "title": "Rubric",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "domain": {
      "type": "string",
      "enum": [
        "correctness",
        "security",
        "spec-conformance",
        "visual",
        "accessibility",
        "performance",
        "docs-and-changelog",
        "agent-behaviour"
      ]
    },
    "code": {
      "type": "string",
      "enum": [
        "COR",
        "SEC",
        "SPEC",
        "VIS",
        "A11Y",
        "PERF",
        "DOC",
        "AGENT"
      ]
    },
    "version": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "reviewers": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "notCovered": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "examples": {
      "type": "object",
      "properties": {
        "S0": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "S1": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "S2": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "S3": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "S0",
        "S1",
        "S2"
      ],
      "additionalProperties": false
    },
    "controlsNote": {
      "type": "string"
    },
    "items": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^RUB-(COR|SEC|SPEC|VIS|A11Y|PERF|DOC|AGENT)-\\d{2}$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "test": {
            "type": "string",
            "minLength": 1
          },
          "typicalSeverity": {
            "type": "string",
            "enum": [
              "S0",
              "S1",
              "S2",
              "S3"
            ]
          },
          "verify": {
            "type": "string",
            "minLength": 1
          },
          "falsePositives": {
            "type": "string",
            "minLength": 1
          },
          "controls": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^SEC-[A-Z]+-\\d{2}$"
            }
          }
        },
        "required": [
          "id",
          "title",
          "test",
          "typicalSeverity",
          "verify",
          "falsePositives"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "domain",
    "code",
    "version",
    "title",
    "reviewers",
    "purpose",
    "scope",
    "notCovered",
    "examples",
    "items"
  ],
  "additionalProperties": false
}
