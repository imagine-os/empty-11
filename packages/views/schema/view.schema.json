        "visible": {
          "default": true,
          "type": "boolean"
        },
        "order": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "frozen": {
          "type": "boolean"
        }
      },
      "required": ["fieldId", "order"],
      "additionalProperties": false
    },
    "FieldId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "FilterTree": {},
    "Sort": {
      "type": "object",
      "properties": {
        "fieldId": {
          "$ref": "#/$defs/FieldId"
        },
        "direction": {
          "$ref": "#/$defs/SortDirection"
        },
        "nulls": {
          "type": "string",
          "enum": ["first", "last"]
        }
      },
      "required": ["fieldId", "direction"],
      "additionalProperties": false
    },
    "SortDirection": {
      "type": "string",
      "enum": ["asc", "desc"]
    },
    "Group": {
      "type": "object",
      "properties": {
        "fieldId": {
          "$ref": "#/$defs/FieldId"
        },
        "direction": {
          "default": "asc",
