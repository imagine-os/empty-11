        "scope": {
          "default": "footer",
          "type": "string",
          "enum": ["footer", "group", "both"]
        }
      },
      "required": ["fieldId", "fn"],
      "additionalProperties": false
    },
    "AggregateFn": {
      "type": "string",
      "enum": [
        "count",
        "countEmpty",
        "countFilled",
        "countUnique",
        "percentEmpty",
        "percentFilled",
        "percentUnique",
        "sum",
        "avg",
        "median",
        "min",
        "max",
        "range",
        "stdDev",
        "earliest",
        "latest",
        "dateRangeDays",
        "checked",
        "unchecked",
        "percentChecked",
        "concat"
      ]
    },
    "RowHeight": {
      "type": "string",
      "enum": ["short", "medium", "tall", "extraTall"]
    },
    "ViewSearch": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "maxLength": 200
        },
        "fieldIds": {
          "maxItems": 50,
          "type": "array",
          "items": {
            "$ref": "#/$defs/FieldId"
          }
        }
      },
      "required": ["query"],
      "additionalProperties": false
    },
    "Visibility": {
      "type": "string",
      "enum": ["personal", "shared", "public"]
    },
    "Uuid": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "ViewPermissions": {
      "type": "object",
      "properties": {
        "canEditRecords": {
          "maxItems": 32,
          "type": "array",
          "items": {
            "$ref": "#/$defs/AudienceId"
