    {
      "$ref": "#/$defs/GridViewSpec"
    },
    {
      "$ref": "#/$defs/KanbanViewSpec"
    },
    {
      "$ref": "#/$defs/CalendarViewSpec"
    },
    {
      "$ref": "#/$defs/TimelineViewSpec"
    },
    {
      "$ref": "#/$defs/GanttViewSpec"
    },
    {
      "$ref": "#/$defs/GalleryViewSpec"
    },
    {
      "$ref": "#/$defs/ListViewSpec"
    },
    {
      "$ref": "#/$defs/FormViewSpec"
    },
    {
      "$ref": "#/$defs/MapViewSpec"
    },
    {
      "$ref": "#/$defs/ChartViewSpec"
    }
  ],
  "$defs": {
    "GridViewSpec": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/UuidV7"
        },
        "version": {
          "type": "number",
          "const": 3
        },
        "datasetRef": {
          "$ref": "#/$defs/DatasetRef"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "description": {
          "type": "string",
          "maxLength": 2000
        },
        "fields": {
          "maxItems": 500,
          "type": "array",
          "items": {
            "$ref": "#/$defs/ViewField"
          }
        },
        "filter": {
          "$ref": "#/$defs/FilterTree"
        },
        "sorts": {
          "default": [],
          "maxItems": 5,
          "type": "array",
          "items": {
            "$ref": "#/$defs/Sort"
          }
        },
        "groups": {
          "default": [],
          "maxItems": 3,
          "type": "array",
          "items": {
            "$ref": "#/$defs/Group"
          }
        },
        "aggregations": {
          "default": [],
          "maxItems": 100,
          "type": "array",
          "items": {
            "$ref": "#/$defs/Aggregation"
          }
        },
        "rowHeight": {
          "default": "short",
          "$ref": "#/$defs/RowHeight"
        },
        "search": {
          "$ref": "#/$defs/ViewSearch"
        },
        "visibility": {
          "$ref": "#/$defs/Visibility"
        },
        "ownerUserId": {
          "$ref": "#/$defs/Uuid"
        },
        "permissions": {
          "$ref": "#/$defs/ViewPermissions"
        },
        "sharing": {
          "$ref": "#/$defs/ViewSharing"
        },
        "locked": {
          "default": false,
          "type": "boolean"
        },
        "formats": {},
        "colorBy": {},
        "kind": {
          "type": "string",
          "const": "grid"
        },
        "options": {
          "$ref": "#/$defs/GridOptions"
        }
      },
      "required": [
        "id",
        "version",
        "datasetRef",
        "name",
        "fields",
        "visibility",
        "ownerUserId",
        "permissions",
        "kind",
        "options"
      ],
      "additionalProperties": false
    },
    "UuidV7": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-7[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$"
    },
    "DatasetRef": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "entity"
            },
            "key": {
              "$ref": "#/$defs/Slug"
            }
          },
          "required": ["kind", "key"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "custom"
            },
            "datasetId": {
              "$ref": "#/$defs/UuidV7"
            }
          },
          "required": ["kind", "datasetId"],
          "additionalProperties": false
        }
      ]
    },
    "Slug": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}$"
    },
    "ViewField": {
      "type": "object",
      "properties": {
        "fieldId": {
          "$ref": "#/$defs/FieldId"
        },
        "width": {
          "type": "integer",
          "minimum": 24,
          "maximum": 2000
