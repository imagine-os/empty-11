      "required": ["fieldId"],
      "additionalProperties": false
    },
    "DateBucket": {
      "type": "string",
      "enum": ["day", "week", "month", "quarter", "year"]
    },
    "Aggregation": {
      "type": "object",
      "properties": {
        "fieldId": {
          "$ref": "#/$defs/FieldId"
        },
        "fn": {
          "$ref": "#/$defs/AggregateFn"
        },
        "label": {
          "type": "string",
          "maxLength": 60
