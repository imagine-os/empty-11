{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paperos.dev/schema/field-def/1",
  "title": "FieldDef",
  "description": "PaperOS dataset field definition (PAP-161, ADR 0016). Generated by `pnpm --filter @paperos/views gen:schemas`; do not edit.",
  "type": "object",
  "properties": {
    "id": {
      "$ref": "#/$defs/FieldId"
    },
    "key": {
      "$ref": "#/$defs/Slug"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "type": {
      "$ref": "#/$defs/FieldType"
    },
    "options": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    },
    "required": {
      "default": false,
      "type": "boolean"
    },
    "unique": {
      "default": false,
      "type": "boolean"
    },
    "hidden": {
      "default": false,
      "type": "boolean"
    },
    "computed": {
      "default": false,
      "type": "boolean"
    },
    "description": {
      "type": "string",
      "maxLength": 500
    },
    "group": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "defaultValue": {},
    "permissions": {}
  },
  "required": ["id", "key", "name", "type"],
  "additionalProperties": false,
  "$defs": {
    "FieldId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "Slug": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}$"
    },
    "FieldType": {
      "type": "string",
      "enum": [
        "text",
        "longText",
        "number",
        "currency",
        "percent",
        "date",
        "checkbox",
        "rating",
        "url",
        "email",
        "phone",
        "select",
        "multiSelect",
        "user",
        "attachment",
        "relation",
        "lookup",
        "rollup",
        "formula",
        "geo",
        "button",
        "autonumber",
        "createdTime",
        "lastModifiedTime",
        "createdBy",
        "lastModifiedBy",
        "richText",
        "duration",
        "time",
        "progress",
        "json"
      ]
    }
  }
}
