{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paperos.dev/schema/agents/roster.schema.json",
  "$comment": "Generated by `pnpm --filter @paperos/agents gen:schemas` from packages/agents/src/schema/character.ts (schemaVersion 1). Do not edit by hand.",
  "$ref": "#/$defs/Roster",
  "$defs": {
    "Roster": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "number",
          "const": 1
        },
        "dailyAllowanceUsd": {
          "description": "Daily credit allowance the lead shares divide (about 700 USD)",
          "type": "number",
          "exclusiveMinimum": 0
        },
        "defaults": {
          "description": "Roster-wide defaults per kind; without them every character must carry a full budget",
          "type": "object",
          "properties": {
            "lead": {
              "type": "object",
              "properties": {
                "model": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)+$",
                  "description": "Model id from the PAP-98 price table; unknown ids warn"
                },
                "fallbackModel": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)+$",
                  "description": "Model id from the PAP-98 price table; unknown ids warn"
                },
                "effort": {
                  "description": "Reasoning effort default. `xhigh` is an accepted alias for `high`.",
                  "type": "string",
                  "enum": [
                    "low",
                    "medium",
                    "high",
                    "xhigh",
                    "max"
                  ]
                },
                "permissionMode": {
                  "type": "string",
                  "enum": [
                    "default",
                    "acceptEdits",
                    "plan",
                    "dontAsk"
                  ],
                  "description": "Claude Code permission mode the session starts in"
                },
                "budget": {
                  "type": "object",
                  "properties": {
                    "perSessionUsd": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "perDayUsd": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "maxTurns": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    },
                    "dailySharePct": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 100
                    }
                  },
                  "required": [
                    "perSessionUsd",
                    "perDayUsd",
                    "maxTurns"
                  ],
                  "additionalProperties": false,
                  "description": "Hard caps enforced by PAP-111; never unlimited"
                },
                "memoryMaxTokens": {
                  "type": "object",
                  "properties": {
                    "global": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    },
                    "project": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    },
                    "character": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    }
                  },
                  "required": [
                    "global",
                    "project",
                    "character"
                  ],
                  "additionalProperties": false
                },
                "denyList": {
                  "default": "ops/security/agent-deny.yaml",
                  "type": "string"
                }
              },
              "required": [
                "model",
                "fallbackModel",
                "effort",
                "permissionMode",
                "budget",
                "memoryMaxTokens"
              ],
              "additionalProperties": false,
              "description": "Roster-wide defaults; the last fallback before a value would be missing"
            },
            "sub": {
              "type": "object",
              "properties": {
                "model": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)+$",
                  "description": "Model id from the PAP-98 price table; unknown ids warn"
                },
                "fallbackModel": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)+$",
                  "description": "Model id from the PAP-98 price table; unknown ids warn"
                },
                "effort": {
                  "description": "Reasoning effort default. `xhigh` is an accepted alias for `high`.",
                  "type": "string",
                  "enum": [
                    "low",
                    "medium",
                    "high",
                    "xhigh",
                    "max"
                  ]
                },
                "permissionMode": {
                  "type": "string",
                  "enum": [
                    "default",
                    "acceptEdits",
                    "plan",
                    "dontAsk"
                  ],
                  "description": "Claude Code permission mode the session starts in"
                },
                "budget": {
                  "type": "object",
                  "properties": {
                    "perSessionUsd": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "perDayUsd": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "maxTurns": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    },
                    "dailySharePct": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 100
                    }
                  },
                  "required": [
                    "perSessionUsd",
                    "perDayUsd",
                    "maxTurns"
                  ],
                  "additionalProperties": false,
                  "description": "Hard caps enforced by PAP-111; never unlimited"
                },
                "memoryMaxTokens": {
                  "type": "object",
                  "properties": {
                    "global": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    },
                    "project": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    },
                    "character": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    }
                  },
                  "required": [
                    "global",
                    "project",
                    "character"
                  ],
                  "additionalProperties": false
                },
                "denyList": {
                  "default": "ops/security/agent-deny.yaml",
                  "type": "string"
                }
              },
              "required": [
                "model",
                "fallbackModel",
                "effort",
                "permissionMode",
                "budget",
                "memoryMaxTokens"
              ],
              "additionalProperties": false,
              "description": "Roster-wide defaults; the last fallback before a value would be missing"
            }
          },
          "required": [
            "lead",
            "sub"
          ],
          "additionalProperties": false
        },
        "characters": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/$defs/Character"
          }
        }
      },
      "required": [
        "schemaVersion",
        "characters"
      ],
      "additionalProperties": false,
      "title": "PaperOS roster",
      "description": "Roster defaults plus every character"
    },
    "Character": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "number",
          "const": 1
        },
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 48,
          "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
          "description": "kebab-case identifier, unique across the roster"
        },
        "displayName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 64
        },
        "role": {
          "type": "string",
          "minLength": 4,
          "maxLength": 200,
          "description": "Role title, e.g. \"Platform Engineer\""
        },
        "kind": {
          "type": "string",
          "enum": [
            "lead",
            "sub"
          ],
          "description": "`lead` reports to justin or another lead; `sub` is spawned by its `parent` lead with a narrower bundle"
        },
        "reportsTo": {
          "anyOf": [
            {
              "type": "string",
              "const": "justin"
            },
            {
              "type": "string",
              "minLength": 2,
              "maxLength": 48,
              "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
              "description": "kebab-case identifier, unique across the roster"
            }
          ],
          "description": "Character name this one reports to, or `justin`"
        },
        "parent": {
          "description": "Lead that spawns this sub (required for `sub`)",
          "type": "string",
          "minLength": 2,
          "maxLength": 48,
          "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
        },
        "description": {
          "type": "string",
          "minLength": 20,
          "maxLength": 600,
          "description": "When to delegate to this character; drives Claude Code sub-agent delegation"
        },
        "model": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)+$",
          "description": "Model id from the PAP-98 price table; unknown ids warn"
        },
        "fallbackModel": {
          "description": "Overload fallback (never used for refusals); must exist in the price table",
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)+$"
        },
        "effort": {
          "description": "Reasoning effort default. `xhigh` is an accepted alias for `high`.",
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high",
            "xhigh",
            "max"
          ]
        },
        "permissionMode": {
          "type": "string",
          "enum": [
            "default",
            "acceptEdits",
            "plan",
            "dontAsk"
          ],
          "description": "Claude Code permission mode the session starts in"
        },
        "maxParallelSessions": {
          "description": "How many sessions of this character may run at once (PAP-99)",
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        },
        "tools": {
          "type": "object",
          "properties": {
            "allow": {
              "default": [],
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^(?:[A-Z][A-Za-z]*(?:\\(.+\\))?|mcp__[a-z][a-z0-9-]*(?:__(?:[A-Za-z][A-Za-z0-9_-]*|\\*))?)$",
                "description": "Built-in tool (`Bash`, `Bash(pnpm *)`) or MCP tool (`mcp__linear__create_issue`)"
              }
            },
            "deny": {
              "default": [],
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^(?:[A-Z][A-Za-z]*(?:\\(.+\\))?|mcp__[a-z][a-z0-9-]*(?:__(?:[A-Za-z][A-Za-z0-9_-]*|\\*))?)$",
                "description": "Built-in tool (`Bash`, `Bash(pnpm *)`) or MCP tool (`mcp__linear__create_issue`)"
              }
            }
          },
          "additionalProperties": false,
          "description": "Tool allow and deny lists; deny wins. Subs must stay within their lead."
        },
        "mcpServers": {
          "default": [],
          "description": "MCP catalog ids (PAP-210)",
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 2,
            "maxLength": 48,
            "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
            "description": "kebab-case identifier, unique across the roster"
          }
        },
        "access": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*:[a-z][a-z0-9-]*(?::[a-z0-9.][a-z0-9._/-]*)?$",
            "description": "Access scope from the registry (`packages/agents/src/schema/scopes.ts`)"
          }
        },
        "plugins": {
          "default": [],
          "description": "Claude Code plugin ids",
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 2,
            "maxLength": 48,
            "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
            "description": "kebab-case identifier, unique across the roster"
          }
        },
        "skills": {
          "default": [],
          "description": "Skill ids from `.claude/skills` (PAP-105)",
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 2,
            "maxLength": 48,
            "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
            "description": "kebab-case identifier, unique across the roster"
          }
        },
        "memory": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^docs\\/memory\\/.+\\.md$"
            },
            "maxTokens": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 20000
            }
          },
          "required": [
            "path",
            "maxTokens"
          ],
          "additionalProperties": false,
          "description": "Character memory file (PAP-109) and its token budget"
        },
        "budget": {
          "type": "object",
          "properties": {
            "perSessionUsd": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "perDayUsd": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "maxTurns": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "dailySharePct": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            }
          },
          "additionalProperties": false
        },
        "escalation": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "when": {
                "type": "string",
                "minLength": 8,
                "maxLength": 400
              },
              "action": {
                "type": "string",
                "enum": [
                  "escalate",
                  "needs-justin",
                  "proceed",
                  "stop"
                ],
                "description": "`escalate` to the character in `to`; `needs-justin` files a PAP-94 card through Atlas; `proceed` records the default and continues; `stop` ends the session"
              },
              "to": {
                "type": "string",
                "minLength": 2,
                "maxLength": 48,
                "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
                "description": "kebab-case identifier, unique across the roster"
              }
            },
            "required": [
              "when",
              "action"
            ],
            "additionalProperties": false,
            "description": "One escalation rule: situation and what the session does"
          }
        },
        "denyList": {
          "default": "ops/security/agent-deny.yaml",
          "description": "Path of the destructive-action deny list every bundle loads (threat model §4)",
          "type": "string"
        },
        "linearLabel": {
          "type": "string",
          "pattern": "^Character\\/[A-Z][A-Za-z]+$",
          "description": "Linear label the orchestrator routes on (leads only)"
        },
        "subCharacters": {
          "description": "Names of this lead's subs (leads only)",
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 2,
            "maxLength": 48,
            "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
            "description": "kebab-case identifier, unique across the roster"
          }
        }
      },
      "required": [
        "schemaVersion",
        "name",
        "displayName",
        "role",
        "kind",
        "reportsTo",
        "description"
      ],
      "additionalProperties": false,
      "title": "PaperOS character",
      "description": "One Claude character (lead or sub) as declared in packages/agents/characters/*.yaml"
    }
  }
}
