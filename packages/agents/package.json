{
  "name": "@paperos/agents",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Character schema, handoff artefacts and agent runtime ports.",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./roster": "./src/roster/index.ts"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "src",
    "schema",
    "fixtures",
    "characters",
    "roster.yaml"
  ],
  "scripts": {
    "lint": "biome check .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "gen:schemas": "node scripts/gen-schemas.ts",
    "gen:fixtures": "node scripts/gen-fixtures.ts",
    "convert:plan": "node scripts/convert-plan.ts",
    "validate": "node scripts/validate.ts",
    "tree": "node scripts/tree.ts",
    "plan-to-roster": "node scripts/plan-to-roster.ts",
    "clean": "node -e \"require('node:fs').rmSync('coverage',{recursive:true,force:true})\""
  },
  "dependencies": {
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@paperos/config-ts": "workspace:*",
    "@types/node": "catalog:",
    "fast-check": "^4.10.1",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
