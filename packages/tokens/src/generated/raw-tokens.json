          "font-family": "\"JetBrains Mono\", ui-monospace, SFMono-Regular, monospace",
          "font-size": "calc(clamp(0.875rem, calc(0.8491rem + 0.1149vw), 1.125rem) * var(--pos-font-scale, 1))",
          "line-height": "1.5",
          "font-weight": "400"
        }
      }
    },
    "focus": {
      "ring": {
        "width": "0.125rem",
        "offset": "0.125rem"
      }
    }
  }
}
