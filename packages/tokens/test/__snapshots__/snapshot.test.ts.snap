  --pos-shadow-role-3: 0 4px 8px rgba(0, 0, 0, 0.52), 0 2px 4px rgba(0, 0, 0, 0.32);
  --pos-shadow-role-4: 0 8px 16px rgba(0, 0, 0, 0.56), 0 4px 8px rgba(0, 0, 0, 0.36);
  --pos-shadow-role-5: 0 16px 32px rgba(0, 0, 0, 0.64), 0 6px 12px rgba(0, 0, 0, 0.4);
  }
  [data-theme="hc"] {
  --pos-color-accent-active: rgb(0, 0, 0);
  --pos-color-accent-default: rgb(6, 25, 58);
  --pos-color-accent-hover: rgb(0, 0, 0);
  --pos-color-bg-canvas: rgb(255, 255, 255);
  --pos-color-bg-overlay: rgba(0, 0, 0, 0.8);
  --pos-color-bg-raised: rgb(255, 255, 255);
  --pos-color-bg-surface: rgb(255, 255, 255);
  --pos-color-border-default: rgb(0, 0, 0);
  --pos-color-border-focus: rgb(0, 0, 0);
  --pos-color-border-strong: rgb(0, 0, 0);
  --pos-color-danger-bg: rgb(255, 255, 255);
  --pos-color-danger-border: rgb(0, 0, 0);
  --pos-color-danger-fg: rgb(53, 8, 8);
  --pos-color-fg-default: rgb(0, 0, 0);
  --pos-color-fg-muted: rgb(64, 66, 71);
  --pos-color-fg-on-accent: rgb(255, 255, 255);
  --pos-color-fg-subtle: rgb(85, 88, 94);
  --pos-color-focus: rgb(0, 0, 0);
  --pos-color-info-bg: rgb(255, 255, 255);
  --pos-color-info-border: rgb(0, 0, 0);
  --pos-color-info-fg: rgb(0, 30, 43);
  --pos-color-success-bg: rgb(255, 255, 255);
  --pos-color-success-border: rgb(0, 0, 0);
  --pos-color-success-fg: rgb(4, 34, 7);
  --pos-color-warning-bg: rgb(255, 255, 255);
  --pos-color-warning-border: rgb(0, 0, 0);
  --pos-color-warning-fg: rgb(38, 24, 0);
  --pos-shadow-role-1: 0 0 0 1px rgb(0, 0, 0);
  --pos-shadow-role-2: 0 0 0 1px rgb(0, 0, 0);
  --pos-shadow-role-3: 0 0 0 1px rgb(0, 0, 0);
  --pos-shadow-role-4: 0 0 0 2px rgb(0, 0, 0);
  --pos-shadow-role-5: 0 0 0 2px rgb(0, 0, 0);
  }
}
"
`;
