{
  "name": "@paperos/boundaries",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Package boundary map: ownership.json schema loading, dependency-cruiser rule generation and the dependency map (PAP-305).",
  "exports": {
    ".": "./src/index.ts"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "src"
  ],
  "scripts": {
    "lint": "biome check .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "gen:deps-rules": "tsx scripts/gen-deps-rules.ts",
    "gen:dep-map": "tsx scripts/gen-dep-map.ts",
    "clean": "node -e \"require('node:fs').rmSync('coverage',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@paperos/core": "workspace:*"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@paperos/config-ts": "workspace:*",
    "@types/node": "catalog:",
    "dependency-cruiser": "18.3.1",
    "tsx": "^4.23.13",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
