{
  "name": "@paperos/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Drizzle schema-as-code for PaperOS Postgres: tables, column helpers and the outbox driver.",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./testing": "./src/testing/pglite.ts"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "src"
  ],
  "scripts": {
    "lint": "biome check .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "clean": "node -e \"require('node:fs').rmSync('coverage',{recursive:true,force:true})\"",
    "events:example": "tsx ../../examples/events.ts"
  },
  "dependencies": {
    "@paperos/core": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@electric-sql/pglite": "^0.5.8",
    "@paperos/config-biome": "workspace:*",
    "@paperos/config-ts": "workspace:*",
    "@types/node": "catalog:",
    "tsx": "^4.20.6",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
