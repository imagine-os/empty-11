{
  "name": "@paperos/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Contract-zero primitives: pure TypeScript, no React, no database.",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./events": "./src/events/index.ts",
    "./events/testing": "./src/events/testing.ts",
    "./filter": "./src/filter/index.ts",
    "./config": "./src/config/index.ts"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "src"
  ],
  "scripts": {
    "lint": "biome check . && tsx ../../scripts/events-catalogue.ts --check",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "env:check": "tsx src/config/env-check.cli.ts",
    "clean": "node -e \"require('node:fs').rmSync('coverage',{recursive:true,force:true})\"",
    "example:filter": "tsx examples/filter.ts",
    "events:catalogue": "tsx ../../scripts/events-catalogue.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@electric-sql/pglite": "^0.5.8",
    "@paperos/config-ts": "workspace:*",
    "@types/node": "catalog:",
    "fast-check": "^4.10.1",
    "tsx": "^4.23.13",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
