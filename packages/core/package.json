{
  "name": "@paperos/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Contract-zero primitives: pure TypeScript, no React, no database.",
  "exports": {
    ".": "./src/index.ts",
    "./events": "./src/events/index.ts",
    "./events/testing": "./src/events/testing.ts",
    "./filter": "./src/filter/index.ts",
    "./modules": "./src/modules/index.ts"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "src"
  ],
  "scripts": {
    "lint": "biome check . && tsx ../../scripts/events-catalogue.ts --check",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests && pnpm run test:coverage",
    "test:coverage": "vitest run --coverage --passWithNoTests src/modules",
    "clean": "node -e \"require('node:fs').rmSync('coverage',{recursive:true,force:true})\"",
    "example:filter": "tsx examples/filter.ts",
    "events:catalogue": "tsx ../../scripts/events-catalogue.ts",
    "gen:schemas": "tsx src/modules/gen-schemas.ts",
    "modules:validate": "tsx src/modules/cli.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@electric-sql/pglite": "^0.5.8",
    "@paperos/config-ts": "workspace:*",
    "@types/semver": "^7.8.0",
    "@vitest/coverage-v8": "catalog:",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "fast-check": "^4.10.1",
    "tsx": "^4.23.13",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "semver": "^7.8.5",
    "zod": "^4.6.5"
  }
}
