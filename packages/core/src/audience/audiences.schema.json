{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paperos.dev/schemas/app-spec/audiences.schema.json",
  "$comment": "GENERATED by `pnpm --filter @paperos/core gen:audience-schema` from packages/core/src/audience/app-spec.ts. Do not edit; PAP-55, ADR 0017.",
  "title": "PaperOS app.spec.yaml audiences section",
  "description": "Audiences an app declares on top of the built-ins: id (kebab-case segments joined by dots) to { name, description, match }. Built-in ids cannot be redeclared.",
  "type": "object",
  "propertyNames": {
    "type": "string",
    "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*(?:\\.[a-z][a-z0-9]*(?:-[a-z0-9]+)*)*$"
  },
  "additionalProperties": {
    "type": "object",
    "properties": {
      "name": {
        "type": "string",
        "minLength": 1
      },
      "description": {
        "type": "string",
        "minLength": 1
      },
      "match": {
        "$ref": "#/$defs/Segment"
      }
    },
    "required": ["name", "description", "match"],
    "additionalProperties": false
  },
  "$defs": {
    "Segment": {
      "title": "Segment",
      "description": "A boolean tree over principal attributes; depth is limited to 6.",
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "all": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Segment"
              }
            }
          },
          "required": ["all"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "any": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Segment"
              }
            }
          },
          "required": ["any"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "not": {
              "$ref": "#/$defs/Segment"
            }
          },
          "required": ["not"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "attr": {
              "type": "string",
              "minLength": 1
            },
            "op": {
              "type": "string",
              "enum": ["eq", "neq", "in", "gte", "lte", "exists"]
            },
            "value": {
              "anyOf": [
                {
                  "type": ["string", "number", "boolean"]
                },
                {
                  "type": "array",
                  "items": {
                    "type": ["string", "number", "boolean"]
                  }
                }
              ]
            }
          },
          "required": ["attr", "op"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "role": {
              "type": "string",
              "enum": ["owner", "admin", "staff", "member", "viewer"]
            }
          },
          "required": ["role"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "principalType": {
              "type": "string",
              "enum": ["human", "agent", "service", "anonymous"]
            }
          },
          "required": ["principalType"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "tier": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": ["tier"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "audience": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*(?:\\.[a-z][a-z0-9]*(?:-[a-z0-9]+)*)*$"
            }
          },
          "required": ["audience"],
          "additionalProperties": false
        }
      ]
    }
  }
}
