# Fixed values Vitest reads (packages/core/src/config/env-source.ts:
# readNodeEnv() loads exactly this file when NODE_ENV=test, never .env.local).
# Committed on purpose — CI has no .env.local, and tests must be deterministic
# without depending on whatever a developer happens to have locally. Not real
# credentials; nothing here reaches a real service.

VITE_API_URL=https://api.paperos.test
VITE_APP_NAME=PaperOS
VITE_GIT_SHA=test
VITE_ELECTRIC_URL=https://electric.paperos.test
VITE_YJS_URL=wss://yjs.paperos.test
VITE_SENTRY_DSN=
VITE_FLAGS=

NODE_ENV=test
DATABASE_URL=postgres://paperos:paperos@localhost:5432/paperos_test
DATABASE_URL_MIGRATOR=postgres://paperos_migrator:paperos@localhost:5432/paperos_test
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=test
S3_SECRET_KEY=test
S3_BUCKET=paperos-test
BETTER_AUTH_SECRET=test-only-not-a-real-secret
BETTER_AUTH_URL=http://localhost:3000
STRIPE_SECRET_KEY=
OTEL_EXPORTER_OTLP_ENDPOINT=
APP_ENCRYPTION_KEY=
