# PaperOS environment and config layer (PAP-17). Full picture, including what
# CI and Coolify supply and how secrets rotate, is docs/platform/config.md.
#
# Rules this file follows so `pnpm --filter @paperos/core env:check` stays
# meaningful:
#   - Every key `publicEnvSchema` / `serverEnvSchema` declares (and every key a
#     module adds through the config registry) has a line here, even when the
#     placeholder is empty (`KEY=`) for an optional key.
#   - Real values never land here — this file is committed. `.env.local`
#     (gitignored) holds real per-developer values; `.env.test` (committed —
#     see the note by its own file) holds the fixed values Vitest reads.

# Base path the web app is served from (GitHub Pages sets a sub-path).
BASE_PATH=/

## --- publicEnvSchema: VITE_* only. These, and only these, may reach a ------
## --- browser bundle (packages/core/src/config/vite-plugin.ts fails the ----
## --- build otherwise). --------------------------------------------------

# Base URL of the API the shell talks to.
VITE_API_URL=http://localhost:3000
# Product name shown in chrome, titles and the message-catalog fallback.
VITE_APP_NAME=PaperOS
# Commit SHA stamped into the build; CI sets it from the checkout.
VITE_GIT_SHA=dev
# Electric sync service the client subscribes to.
VITE_ELECTRIC_URL=http://localhost:5133
# Yjs / Hocuspocus realtime endpoint.
VITE_YJS_URL=ws://localhost:1234
# Sentry DSN; leave empty to disable client error reporting.
VITE_SENTRY_DSN=
# Comma-separated flag names turned on before the runtime flag service exists. Bootstrap only.
VITE_FLAGS=

## --- serverEnvSchema: never VITE_-prefixed, never sent to a browser, -------
## --- desktop-webview or mobile-webview bundle. --------------------------

NODE_ENV=development

# App-role connection, routed through PgBouncer everywhere but local dev.
DATABASE_URL=postgres://paperos:paperos@localhost:5432/paperos
# Owner-role connection used only to run migrations.
DATABASE_URL_MIGRATOR=postgres://paperos_migrator:paperos@localhost:5432/paperos

S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=paperos-dev
S3_SECRET_KEY=paperos-dev
S3_BUCKET=paperos-dev

BETTER_AUTH_SECRET=dev-only-not-a-real-secret
BETTER_AUTH_URL=http://localhost:3000

# Set once billing (business-core) is enabled; empty otherwise.
STRIPE_SECRET_KEY=
# OpenTelemetry OTLP collector endpoint; empty disables tracing export.
OTEL_EXPORTER_OTLP_ENDPOINT=
# Consumed by the field-encryption issue (data-layer), not by this layer.
APP_ENCRYPTION_KEY=
