{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./packages/config-ts/base.json",
  "compilerOptions": {
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@paperos/contract-*": ["packages/contracts/*/src"],
      "@paperos/*": ["packages/*/src"]
    }
  },
  "include": ["*.ts", "*.config.ts"],
  "exclude": ["node_modules", "**/dist", "**/coverage"]
}
