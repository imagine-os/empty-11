{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "spike": {
      "type": "string",
      "minLength": 1
    },
    "measuredAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "method": {
      "type": "string",
      "minLength": 1
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "lib": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "measuredAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          },
          "bundle": {
            "type": "object",
            "properties": {
              "gzipBytes": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": 0
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "sharedBaselineGzipBytes": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": 0
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "notMeasuredReason": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "gzipBytes",
              "sharedBaselineGzipBytes",
              "notMeasuredReason"
            ],
            "additionalProperties": false
          },
          "runtime": {
            "type": "object",
            "properties": {
              "wallTimeMeanMs": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": 0
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "wallTimeP5Ms": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": 0
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "heapUsedDeltaBytes": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "rssDeltaBytes": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "runs": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "stable": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "notMeasuredReason": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "wallTimeMeanMs",
              "wallTimeP5Ms",
              "heapUsedDeltaBytes",
              "rssDeltaBytes",
              "runs",
              "stable",
              "notMeasuredReason"
            ],
            "additionalProperties": false
          },
          "browser": {
            "type": "object",
            "properties": {
              "meanFps": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": 0
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "p5Fps": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": 0
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "longFrames": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "notMeasuredReason": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "meanFps",
              "p5Fps",
              "longFrames",
              "notMeasuredReason"
            ],
            "additionalProperties": false
          },
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "unstable",
              "failed:peer",
              "error"
            ]
          },
          "notes": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "lib",
          "version",
          "measuredAt",
          "bundle",
          "runtime",
          "browser",
          "status",
          "notes"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "spike",
    "measuredAt",
    "method",
    "candidates"
  ],
  "additionalProperties": false,
  "$id": "https://paperos.dev/schema/spike-results.schema.json",
  "title": "PaperOS spike results summary (PAP-753)"
}
